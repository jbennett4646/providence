# Postgres connection. Leave unset in development to use the embedded
# PGlite database under .data/ (it sets itself up on first use).
DATABASE_URL=postgres://user:password@localhost:5432/providence

# The site's public address, used in password-reset emails and Stripe redirects.
SITE_URL=https://providence-home.academy

# Email (password resets). Without RESEND_API_KEY, emails are written to the server log.
RESEND_API_KEY=
MAIL_FROM="Providence Home Academy <no-reply@providence-home.academy>"

# Stripe. Without STRIPE_SECRET_KEY, billing is off and the app is open to every household.
# Run `npm run stripe:setup` with the secret key set to create the two prices.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_HOUSEHOLD=
STRIPE_PRICE_PARISH=
# Optional free trial on new subscriptions, in days.
STRIPE_TRIAL_DAYS=0
